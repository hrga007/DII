rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Institutions — read za sve prijavljene, write samo admin
    match /institutions/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Import batches
    match /importBatches/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Import issues
    match /importIssues/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Financial entries
    match /financialEntries/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Installed resources
    match /installedResources/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isLoggedIn();
      allow update, delete: if false;
    }

    // Share links — public direct get by token, no public listing
    match /shareLinks/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() && id == request.resource.data.token;
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['viewCount', 'lastViewedAt']);
      allow delete: if isAdmin();
    }
  }
}
